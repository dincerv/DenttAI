# Monitoring credentials (required)
MONITORING_BASIC_AUTH_USER=monitor_admin
MONITORING_BASIC_AUTH_PASSWORD=CHANGE_ME_MONITORING_PROXY_PASSWORD

# Grafana admin credentials (required)
GRAFANA_ADMIN_USER=grafana_admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# Alertmanager email notification settings (required)
ALERTMANAGER_EMAIL_TO=ee.burakozcelik@gmail.com
ALERTMANAGER_EMAIL_FROM=alerts@example.com
ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
ALERTMANAGER_SMTP_AUTH_USERNAME=smtp_user
ALERTMANAGER_SMTP_AUTH_PASSWORD=CHANGE_ME_SMTP_PASSWORD
ALERTMANAGER_SMTP_REQUIRE_TLS=true

# Existing network name used by main stack
MONITORING_NETWORK_NAME=dentai_network
