# ============================================================
# DentAI Flow — Environment Variables
# Bu dosyayı kopyala: cp .env.example .env
# .env dosyasını asla Git'e commit etme!
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=dentai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=dentai_db

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_USER=dentai
RABBITMQ_PASS=CHANGE_ME_RABBITMQ_PASSWORD

# ── JWT (Auth Service) — ZORUNLU, min 32 karakter ───────────
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Public clinic self-registration (default false — invite/admin only)
ALLOW_PUBLIC_REGISTER=false

# ── WhatsApp / Notification ─────────────────────────────────
WHATSAPP_PROVIDER=mock
WHATSAPP_MOCK=true
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8081/api
