# ============================================================
# DentAI Flow — Environment Variables
# Bu dosyayı kopyala: cp .env.example .env
# .env dosyasını asla Git'e commit etme!
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=dentai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=dentai_db

# ── Redis ───────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ── RabbitMQ ────────────────────────────────────────────────
RABBITMQ_USER=dentai
RABBITMQ_PASS=CHANGE_ME_RABBITMQ_PASSWORD

# ── JWT (Auth Service) ──────────────────────────────────────
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── WhatsApp / Notification ─────────────────────────────────
WHATSAPP_API_URL=https://api.whatsapp-provider.com/v1
WHATSAPP_API_KEY=CHANGE_ME_WHATSAPP_KEY

# ── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
