# DentAI Flow — Monolith API için environment değişkenleri
# Bu dosyayı .env olarak kopyalayın: cp .env.example .env

# ── DATABASE (Railway PostgreSQL URL'si) ──────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dentai

# ── REDIS (Railway Redis URL'si) ─────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT (production'da güçlü random secret kullanın) ──────
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_USE_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# ── SERVICE ───────────────────────────────────────────────
SERVICE_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AUTH ──────────────────────────────────────────────────
ALLOW_PUBLIC_REGISTER=false

# ── WHATSAPP (Meta Cloud API) ─────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── AI / LLM ─────────────────────────────────────────────
AI_PROVIDER=gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
