# ──────────────── DATABASE ────────────────
DATABASE_URL=postgresql+asyncpg://dentai:dentai_secret@postgres:5432/dentai_db

# ──────────────── JWT/SECURITY ────────────────
JWT_SECRET=your_32_char_or_longer_secret_key_here
JWT_ALGORITHM=HS256

# ──────────────── SERVICE CONFIG ────────────────
SERVICE_PORT=8005
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# ──────────────── IMPORT/BATCH ────────────────
IMPORT_BATCH_SIZE=200

# ──────────────── CELERY ────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_BACKEND_URL=redis://redis:6379/0

# ──────────────── WHATSAPP ────────────────
# Register at https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_BUSINESS_ACCOUNT_ID=YOUR_BUSINESS_ACCOUNT_ID
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
WHATSAPP_WEBHOOK_VERIFY_TOKEN=dentai_webhook_secret_token

# ──────────────── OPENAI ────────────────
# Register at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_api_key_here
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.2

# ──────────────── CORS ────────────────
CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
